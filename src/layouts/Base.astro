---
import '../styles/global.css';
import { SITE_NAME, TAGLINE, galleries } from '../lib/site';

interface Props {
  title: string;              // page title, without the site name
  description: string;        // meta description, about 150 characters
  jsonLd?: object | object[]; // structured data for search engines
  ogType?: string;
  nav?: 'home' | 'galleries' | 'search' | 'about';
  image?: string;             // share picture, a site path like /images/x.jpg
  imageAlt?: string;
  noindex?: boolean;          // keep this page out of search results (utility pages)
}
const { title, description, jsonLd, ogType = 'website', nav, image, imageAlt, noindex = false } = Astro.props;
const shareImage = image ?? '/share.jpg';
const ogImage = new URL(shareImage, Astro.site).href;
const fullTitle = title === SITE_NAME ? `${SITE_NAME}: ${TAGLINE}` : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? `${SITE_NAME}: ${TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    {ld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/" aria-label={`${SITE_NAME} home`}>
          <span class="logo-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="logo-text">{SITE_NAME}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/galleries/" aria-current={nav === 'galleries' ? 'page' : undefined}>Galleries<span class="nav-count">{galleries.length}</span></a>
          <a href="/search/" aria-current={nav === 'search' ? 'page' : undefined}>Search</a>
          <a href="/about/" aria-current={nav === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{SITE_NAME}: {TAGLINE}</p>
        <p>Every exhibit lists its sources. <a href="/how-we-check/">How we check facts</a></p>
        <p><span>Bluesky: coming soon</span> · <a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a> · <a href="/contact/">Contact</a> · <a href="/suggest/room/">Suggest a room</a></p>
      </div>
    </footer>
  </body>
</html>
