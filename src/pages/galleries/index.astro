---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { galleries, galleryUrl, allExhibits } from '../../lib/site';
const exhibits = await allExhibits();
const count = (slug: string) => exhibits.filter((e) => e.data.gallery === slug).length;
---
<Base title="Galleries" description="Every gallery in Learning Crumbs, each beginning with a question." nav="galleries">
  <Breadcrumbs trail={[{ name: 'Galleries' }]} />
  <section class="placard">
    <h1>Galleries</h1>
    <p class="voice">Each room starts with a question someone actually asked. New rooms open as new questions come up.</p>
  </section>
  <div class="galleries">
    {galleries.map((g) => (
      <a class="gallery-door" href={galleryUrl(g.slug)} data-gallery={g.slug}>
        <span class="eyebrow">Gallery {g.code}</span>
        <h2 style="font-size:var(--step-2)">{g.title}</h2>
        <p class="q" set:html={`“${g.question}”`} />
        <p>{g.summary}</p>
        <div class="meta"><span class="eyebrow">{count(g.slug)} exhibits</span><span>Enter →</span></div>
      </a>
    ))}
  </div>
</Base>
