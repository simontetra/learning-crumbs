---
import Base from '../layouts/Base.astro';
import RoomGrid from '../components/RoomGrid.astro';
import { SITE_NAME, TAGLINE, galleries, galleryUrl, exhibitUrl, allExhibits } from '../lib/site';

const exhibits = await allExhibits();
const byGallery = (slug: string) => exhibits.filter((e) => e.data.gallery === slug);
// A few favourites to start the walk; change these slugs to feature others.
const featured = ['xbox', 'james-bond', 'upper-and-lower-case', 'correction-fluid']
  .map((id) => exhibits.find((e) => e.id === id)!)
  .filter(Boolean);

const roomsJson = JSON.stringify(galleries.map((g, i) => ({ n: i + 1, slug: g.slug, title: g.title, urls: exhibits.filter((e) => e.data.gallery === g.slug).map((e) => exhibitUrl(e.id)) })).filter((r) => r.urls.length));

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: TAGLINE,
  url: Astro.site?.href,
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL('/search/?q={query}', Astro.site).href,
    'query-input': 'required name=query',
  },
};
---
<Base title={SITE_NAME} description="True stories behind everyday names, words and inventions, told as a walk through a museum: one question leads to the next." jsonLd={ld} nav="home" image="/images/hands-on-the-wall.jpg" imageAlt="Ancient hand stencils on a cave wall">
  <section class="entrance">
    <span class="eyebrow">Entrance</span>
    <h1>Every answer leaves a <em>crumb</em> that leads to the next question.</h1>
    <p class="lede">
      It started with my son asking whether I used to write on a typewriter. Each gallery here begins with a question like that,
      then wanders: from a games console to a Viking king, from a goose feather to the keys under your fingers.
    </p>
    <div class="trail-line" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </section>

  <section aria-labelledby="galleries-h">
    <div class="section-head">
      <h2 id="galleries-h">Galleries</h2>
      <span class="eyebrow">{exhibits.length} exhibits</span>
    </div>
    <RoomGrid />

  <section aria-labelledby="start-h" class="start" style="margin-top:56px">
    <div class="section-head">
      <h2 id="start-h">Not sure where to start?</h2>
    </div>
    <div class="start-options">
    <div class="dip">
      <button type="button" class="dip-btn" aria-label="Dip your hand in the bag for a random crumb" data-exhibits={JSON.stringify(exhibits.map((e) => ({ url: exhibitUrl(e.id), title: e.data.title })))}>
        <svg class="dip-art" viewBox="0 0 200 200" aria-hidden="true">
          <g class="dip-bag-art">
            <path d="M34 92 Q100 70 166 92 L174 180 Q100 196 26 180 Z" fill="#b8322a" stroke="#6e1c16" stroke-width="3"/>
            <path d="M34 92 Q100 70 166 92 Q156 116 100 118 Q44 116 34 92 Z" fill="#8f2620" stroke="#6e1c16" stroke-width="2"/>
            <path d="M50 102 Q100 118 150 102" stroke="#e8c06a" stroke-width="3" fill="none"/>
            <path d="M60 130 Q100 140 140 130" stroke="#d9584c" stroke-width="2" fill="none" opacity="0.6"/>
          </g>
          <g class="dip-hand">
            <path d="M128 0 L154 0 L152 56 L128 70 Z" fill="#3d4f7a" stroke="#27324f" stroke-width="2"/>
            <path d="M104 70 Q98 58 110 50 L126 46 Q138 46 138 58 L136 80 Q134 94 120 94 L110 94 Q98 92 104 70 Z" fill="#f2c9a0" stroke="#8a5a3a" stroke-width="2"/>
            <path d="M118 48 L116 80 M126 46 L125 80" stroke="#8a5a3a" stroke-width="1.5" fill="none"/>
            <path d="M104 64 Q94 60 96 68 L104 72" fill="#f2c9a0" stroke="#8a5a3a" stroke-width="2"/>
          </g>
        </svg>
        <span class="dip-label">Feeling lucky? Dip your hand in.</span>
        <span class="dip-result" aria-live="polite"></span>
      </button>
    </div>
    </div>
    <div class="spin" hidden data-rooms={roomsJson}>
      <div class="wheel-wrap">
        <svg class="wheel-pointer" viewBox="0 0 20 24" aria-hidden="true"><path d="M10 24 L0 0 L20 0 Z" fill="#b8322a"/></svg>
        <svg class="wheel" viewBox="-100 -100 200 200" role="img" aria-label="Spin the wheel to land on a random room"><g class="wheel-spin"></g><circle r="9" fill="#fff8e6" stroke="#6e1c16" stroke-width="2"/></svg>
      </div>
      <button type="button" class="spin-btn">Spin the wheel</button>
      <p class="spin-result" aria-live="polite"></p>
    </div>
    </div>
    <script>
      const dip = document.querySelector<HTMLButtonElement>('.dip-btn');
      const result = document.querySelector<HTMLElement>('.dip-btn .dip-result');
      dip?.addEventListener('click', () => {
        const list: { url: string; title: string }[] = JSON.parse(dip.dataset.exhibits || '[]');
        if (!list.length || dip.disabled) return;
        const pick = list[Math.floor(Math.random() * list.length)];
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) { window.location.href = pick.url; return; }
        dip.disabled = true;
        dip.classList.add('diving');
        setTimeout(() => {
          dip.classList.add('shaking');
          let ticks = 0;
          const flick = setInterval(() => {
            result!.textContent = list[Math.floor(Math.random() * list.length)].title;
            if (++ticks >= 14) {
              clearInterval(flick);
              result!.textContent = pick.title;
              setTimeout(() => { window.location.href = pick.url; }, 700);
            }
          }, 110);
        }, 450);
      });
    </script>
    <script>
      const wheelBox = document.querySelector<HTMLElement>('.spin');
      if (wheelBox) {
        wheelBox.hidden = false;
        const rooms: { n: number; slug: string; title: string; urls: string[] }[] = JSON.parse(wheelBox.dataset.rooms || '[]');
        const spinG = wheelBox.querySelector<SVGGElement>('.wheel-spin')!;
        const btn = wheelBox.querySelector<HTMLButtonElement>('.spin-btn')!;
        const result = wheelBox.querySelector<HTMLElement>('.spin-result')!;
        const size = 360 / rooms.length;
        const colour = (slug: string) => {
          const el = document.querySelector<HTMLElement>(`.gallery-door[data-gallery="${slug}"]`);
          return (el && getComputedStyle(el).getPropertyValue('--room-fill').trim()) || '#7a6a55';
        };
        let current = 0;
        const pt = (deg: number, r: number) => [r * Math.sin((deg * Math.PI) / 180), -r * Math.cos((deg * Math.PI) / 180)];
        spinG.innerHTML = rooms.map((r, i) => {
          const a0 = i * size, a1 = (i + 1) * size, mid = a0 + size / 2;
          const [x0, y0] = pt(a0, 96), [x1, y1] = pt(a1, 96);
          const [tx, ty] = pt(mid, 62);
          return `<path d="M0 0 L${x0} ${y0} A96 96 0 0 1 ${x1} ${y1} Z" fill="${colour(r.slug)}" stroke="#fff8e6" stroke-width="1.5"/>` +
            `<text x="${tx}" y="${ty}" transform="rotate(${mid} ${tx} ${ty})" text-anchor="middle" dominant-baseline="middle" font-size="13" font-weight="700" fill="#fff8e6">${r.n}</text>`;
        }).join('');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        btn.addEventListener('click', () => {
          if (btn.disabled) return;
          const w = Math.floor(Math.random() * rooms.length);
          const room = rooms[w];
          const pick = room.urls[Math.floor(Math.random() * room.urls.length)];
          const landed = () => {
            result.textContent = `Room ${room.n}: ${room.title}`;
            setTimeout(() => { window.location.href = pick; }, 900);
          };
          if (reduce) { landed(); return; }
          btn.disabled = true;
          const c = (w + 0.5) * size;
          const base = current + 1800;
          const diff = (((-c - base) % 360) + 360) % 360;
          current = base + diff;
          spinG.style.transform = `rotate(${current}deg)`;
          spinG.addEventListener('transitionend', landed, { once: true });
        });
      }
    </script>
  </section>
</Base>

