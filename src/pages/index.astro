---
import Base from '../layouts/Base.astro';
import RoomGrid from '../components/RoomGrid.astro';
import { SITE_NAME, TAGLINE, galleries, galleryUrl, exhibitUrl, allExhibits } from '../lib/site';

const exhibits = await allExhibits();
const byGallery = (slug: string) => exhibits.filter((e) => e.data.gallery === slug);
// A few favourites to start the walk; change these slugs to feature others.
const featured = ['xbox', 'james-bond', 'upper-and-lower-case', 'correction-fluid']
  .map((id) => exhibits.find((e) => e.id === id)!)
  .filter(Boolean);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: TAGLINE,
  url: Astro.site?.href,
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL('/search/?q={query}', Astro.site).href,
    'query-input': 'required name=query',
  },
};
---
<Base title={SITE_NAME} description="True stories behind everyday names, words and inventions, told as a walk through a museum: one question leads to the next." jsonLd={ld} nav="home" image="/images/hands-on-the-wall.jpg" imageAlt="Ancient hand stencils on a cave wall">
  <section class="entrance">
    <span class="eyebrow">Entrance</span>
    <h1>Every answer leaves a <em>crumb</em> that leads to the next question.</h1>
    <p class="lede">
      It started with my son asking whether I used to write on a typewriter. Each gallery here begins with a question like that,
      then wanders: from a games console to a Viking king, from a goose feather to the keys under your fingers.
    </p>
    <div class="trail-line" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </section>

  <section aria-labelledby="galleries-h">
    <div class="section-head">
      <h2 id="galleries-h">Galleries</h2>
      <span class="eyebrow">{exhibits.length} exhibits</span>
    </div>
    <RoomGrid />

  <section aria-labelledby="start-h" class="start" style="margin-top:56px">
    <div class="section-head">
      <h2 id="start-h">Not sure where to start?</h2>
    </div>
    <p class="voice">Try one of these, or let us choose.</p>
    <div class="dip">
      <button type="button" class="dip-btn" data-exhibits={JSON.stringify(exhibits.map((e) => ({ url: exhibitUrl(e.id), title: e.data.title })))}>
        <svg class="dip-bag" viewBox="0 0 120 80" aria-hidden="true">
          <path d="M14 30 Q60 6 106 30 L112 74 Q60 84 8 74 Z" fill="#c9a46a" stroke="#7a5c2e" stroke-width="2"/>
          <path d="M34 22 L44 44 M60 16 L60 40 M86 22 L76 44" stroke="#7a5c2e" stroke-width="2" fill="none"/>
          <rect x="44" y="6" width="28" height="18" rx="3" fill="#fff8e6" stroke="#7a5c2e" stroke-width="1.5" transform="rotate(-8 58 15)"/>
        </svg>
        <span>Feeling lucky? Dip your hand in.</span>
      </button>
      <p class="dip-result" aria-live="polite"></p>
    </div>
    <ul class="starts">
      {featured.map((e) => (
        <li><a href={exhibitUrl(e.id)}><span class="start-title">{e.data.title}</span><span class="start-sum">{e.data.summary}</span></a></li>
      ))}
    </ul>
    <script>
      const dip = document.querySelector<HTMLButtonElement>('.dip-btn');
      const result = document.querySelector<HTMLElement>('.dip-result');
      dip?.addEventListener('click', () => {
        const list: { url: string; title: string }[] = JSON.parse(dip.dataset.exhibits || '[]');
        if (!list.length || dip.disabled) return;
        const pick = list[Math.floor(Math.random() * list.length)];
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) { window.location.href = pick.url; return; }
        dip.disabled = true;
        dip.classList.add('shaking');
        let ticks = 0;
        const flick = setInterval(() => {
          result!.textContent = list[Math.floor(Math.random() * list.length)].title;
          ticks++;
          if (ticks >= 14) {
            clearInterval(flick);
            result!.textContent = pick.title;
            setTimeout(() => { window.location.href = pick.url; }, 700);
          }
        }, 110);
      });
    </script>
  </section>
</Base>
