---
import Base from '../layouts/Base.astro';
import ExhibitCard from '../components/ExhibitCard.astro';
import TileShare from '../components/TileShare.astro';
import { SITE_NAME, TAGLINE, galleries, galleryUrl, allExhibits } from '../lib/site';

const exhibits = await allExhibits();
const byGallery = (slug: string) => exhibits.filter((e) => e.data.gallery === slug);
// A few favourites to start the walk; change these slugs to feature others.
const featured = ['xbox', 'james-bond', 'upper-and-lower-case', 'correction-fluid']
  .map((id) => exhibits.find((e) => e.id === id)!)
  .filter(Boolean);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: TAGLINE,
  url: Astro.site?.href,
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL('/search/?q={query}', Astro.site).href,
    'query-input': 'required name=query',
  },
};
---
<Base title={SITE_NAME} description="True stories behind everyday names, words and inventions, told as a walk through a museum: one question leads to the next." jsonLd={ld} nav="home" image="/images/hands-on-the-wall.jpg" imageAlt="Ancient hand stencils on a cave wall">
  <section class="entrance">
    <span class="eyebrow">Entrance</span>
    <h1>Every answer leaves a <em>crumb</em> that leads to the next question.</h1>
    <p class="lede">
      It started with my son asking whether I used to write on a typewriter. Each gallery here begins with a question like that,
      then wanders: from a games console to a Viking king, from a goose feather to the keys under your fingers.
    </p>
    <div class="trail-line" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </section>

  <section aria-labelledby="galleries-h">
    <div class="section-head">
      <h2 id="galleries-h">Galleries</h2>
      <span class="eyebrow">{exhibits.length} exhibits</span>
    </div>
    <div class="galleries-wrap">
    <div class="galleries">
      {galleries.map((g, i) => {
        const pic = byGallery(g.slug).find((e) => e.data.image)?.data.image;
        return (
          <div class="gallery-cell" data-index={i}>
          <a class="gallery-door" href={galleryUrl(g.slug)} data-gallery={g.slug}>
            <div class="door-pic" aria-hidden="true">
              {pic ? <img src={pic.src} alt="" loading="lazy" class={pic.fit === 'contain' ? 'print' : undefined} /> : <span class="code">{g.code}</span>}
            </div>
            <div class="door-body">
              <h3>{g.title}</h3>
              <p class="q" set:html={`“${g.question}”`} />
              <span class="eyebrow">{byGallery(g.slug).length} exhibits</span>
            </div>
          </a>
          <TileShare path={galleryUrl(g.slug)} text={`${g.title}: ${g.question}`} />
          </div>
        );
      })}
    </div>
    <nav class="pager" aria-label="Browse rooms" hidden>
      <button type="button" class="pg-prev" hidden>← Earlier rooms</button>
      <span class="pg-label" aria-live="polite"></span>
      <button type="button" class="pg-next">Next rooms →</button>
    </nav>
    </div>
  </section>

  <script>
    // Show 16 rooms at a time, with arrows to move between pages. Without JavaScript every room is shown.
    const wrap = document.querySelector<HTMLElement>('.galleries-wrap');
    if (wrap) {
      const cells = [...wrap.querySelectorAll<HTMLElement>('.gallery-cell')];
      const size = 16;
      const pages = Math.ceil(cells.length / size);
      const nav = wrap.querySelector<HTMLElement>('.pager')!;
      const label = nav.querySelector<HTMLElement>('.pg-label')!;
      const prev = nav.querySelector<HTMLButtonElement>('.pg-prev')!;
      const next = nav.querySelector<HTMLButtonElement>('.pg-next')!;
      let page = 1;
      const show = () => {
        cells.forEach((c, i) => { c.hidden = Math.floor(i / size) + 1 !== page; });
        label.textContent = `Rooms ${(page - 1) * size + 1}–${Math.min(page * size, cells.length)} of ${cells.length}`;
        prev.hidden = page === 1;
        next.hidden = page === pages;
      };
      const go = (to: number) => {
        page = to;
        show();
        wrap.scrollIntoView({ block: 'start', behavior: 'smooth' });
      };
      if (pages > 1) {
        nav.hidden = false;
        prev.addEventListener('click', () => go(page - 1));
        next.addEventListener('click', () => go(page + 1));
        show();
      }
    }
  </script>

  <section aria-labelledby="start-h" style="margin-top:56px">
    <div class="section-head">
      <h2 id="start-h">Pick up a crumb</h2>
    </div>
    <ul class="walk">
      {featured.map((e) => <li><ExhibitCard exhibit={e} /></li>)}
    </ul>
  </section>
</Base>
