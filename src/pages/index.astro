---
import Base from '../layouts/Base.astro';
import RoomGrid from '../components/RoomGrid.astro';
import CrumbTrail from '../components/CrumbTrail.astro';
import { SITE_NAME, TAGLINE, galleries, galleryUrl, exhibitUrl, allExhibits } from '../lib/site';

const exhibits = await allExhibits();
const byGallery = (slug: string) => exhibits.filter((e) => e.data.gallery === slug);
// A few favourites to start the walk; change these slugs to feature others.
const featured = ['xbox', 'james-bond', 'upper-and-lower-case', 'correction-fluid']
  .map((id) => exhibits.find((e) => e.id === id)!)
  .filter(Boolean);


const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: TAGLINE,
  url: Astro.site?.href,
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL('/search/?q={query}', Astro.site).href,
    'query-input': 'required name=query',
  },
};
---
<Base title={SITE_NAME} description="True stories behind everyday names, words and inventions, told as a walk through a museum: one question leads to the next." jsonLd={ld} nav="home" image="/images/hands-on-the-wall.jpg" imageAlt="Ancient hand stencils on a cave wall">
  <div class="home-wrap">
  <CrumbTrail />
  <section class="entrance">
    <h1>Every answer leaves a <em>crumb</em> that leads to the next question.</h1>
    <p class="lede">
      It started with my son asking whether I used to write on a typewriter. Each gallery here begins with a question like that,
      then wanders: from a games console to a Viking king, from a goose feather to the keys under your fingers.
    </p>
    <div class="trail-line" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </section>

  <section aria-labelledby="galleries-h">
    <div class="section-head">
      <h2 id="galleries-h">Galleries</h2>
      <span class="eyebrow">{exhibits.length} exhibits</span>
    </div>
    <p class="map-link"><a href="/map/">See the floor plan</a></p>
    <RoomGrid />

  </div>
</Base>

