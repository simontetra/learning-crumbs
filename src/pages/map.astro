---
import Base from '../layouts/Base.astro';
import FloorPlan from '../components/FloorPlan.astro';
---
<Base title="Floor plan" description="A floor plan of the galleries. Follow the crumbs from room to room, and up or down by the stairs and lift." nav="galleries">
  <section class="placard">
    <h1>Floor plan</h1>
    <p class="voice">You come in on the ground floor. Follow the crumbs from room to room, and use the stairs or the lift to go up.</p>
  </section>

  <FloorPlan />
</Base>
