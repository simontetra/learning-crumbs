---
import Base from '../../layouts/Base.astro';
import { galleries } from '../../lib/site';
---
<Base title="Suggest an artefact" description="Suggest an artefact for a room on Learning Crumbs. Artefacts are checked and sourced before they go live." nav="galleries" noindex>
  <article class="legal">
    <h1>Suggest an artefact</h1>
    <p class="intro">Know an object, idea or story that belongs in one of our rooms? Tell us about it. Every artefact is checked and sourced before it goes live, so we may ask you a question or two. You don't need an account to suggest one.</p>
    <p class="draft"><strong>Not yet connected.</strong> This form will be switched on once the database is set up. Until then, nothing you type is sent anywhere.</p>
    <form class="contact" aria-describedby="artefact-note">
      <label>What is it? <input name="title" type="text" maxlength="80" disabled></label>
      <label>Which room? <select name="gallery" disabled>
        <option value="">Choose one</option>
        {galleries.map((g) => <option value={g.slug}>{g.title}</option>)}
      </select></label>
      <label>Why it belongs in this room <textarea name="why" rows="4" maxlength="800" disabled></textarea></label>
      <label>Where we could check it (links, books or other sources) <textarea name="sources" rows="3" maxlength="800" disabled></textarea></label>
      <fieldset>
        <legend>How should we credit you, if we mention you?</legend>
        <label><input type="radio" name="credit" value="anonymous" checked disabled> Anonymously</label>
        <label><input type="radio" name="credit" value="real_name" disabled> With my real name</label>
        <label><input type="radio" name="credit" value="nickname" disabled> With a nickname</label>
        <label>Name or nickname (if you chose one of these) <input name="display_name" type="text" maxlength="60" disabled></label>
      </fieldset>
      <label>Email (optional, only to tell you when it goes live) <input name="notify_email" type="email" autocomplete="email" disabled></label>
      <button type="submit" disabled>Send suggestion</button>
      <p id="artefact-note" class="draft">Submitting this form will not create an account.</p>
    </form>
  </article>
  <script>
    const gallery = new URLSearchParams(location.search).get('gallery');
    const select = document.querySelector<HTMLSelectElement>('select[name="gallery"]');
    if (gallery && select) select.value = gallery;
  </script>
</Base>
