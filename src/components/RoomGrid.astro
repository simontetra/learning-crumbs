---
// The room grid: one card per room, numbered, with a random picture each visit, share links, and 16 rooms per page.
import { galleries, galleryUrl, allExhibits } from '../lib/site';
import TileShare from './TileShare.astro';
const exhibits = await allExhibits();
const byGallery = (slug: string) => exhibits.filter((e) => e.data.gallery === slug);
---
    <div class="galleries-wrap">
    <div class="galleries">
      {galleries.map((g, i) => {
        const allPics = byGallery(g.slug).filter((e) => e.data.image).map((e) => '/cards/' + e.data.image!.src.split('/').pop()!.replace(/\.[^.]+$/, '.jpg'));
        const pics = allPics.slice(0, 1);
        return (
          <div class="gallery-cell" data-index={i} data-pics={JSON.stringify(i === 0 ? pics : allPics)}>
          <a class="gallery-door" href={galleryUrl(g.slug)} data-gallery={g.slug}>
            <div class={pics.length ? (pics.length === 1 ? 'door-pic solo' : 'door-pic') : 'door-pic solo'} aria-hidden="true">
              {pics.length ? pics.map((p) => (
                <span><img src={p} alt="" loading="lazy" /></span>
              )) : <span class="code-tile"><span class="code">{g.code}</span></span>}
            </div>
            <div class="door-body">
              <h3>{g.title}</h3>
              <p class="q" set:html={`“${g.question}”`} />
              <span class="eyebrow">{byGallery(g.slug).length} exhibits</span>
            </div>
          </a>
          <span class="card-no" aria-hidden="true">{i + 1}</span>
          <TileShare path={galleryUrl(g.slug)} text={`${g.title}: ${g.question}`} />
          </div>
        );
      })}
    </div>
    <nav class="pager" aria-label="Browse rooms" hidden>
      <button type="button" class="pg-arrow pg-prev" aria-label="Earlier rooms" hidden><span class="pg-ring" aria-hidden="true"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <span class="pg-label sr-only" aria-live="polite"></span>
      <button type="button" class="pg-arrow pg-next" aria-label="Next rooms"><span class="pg-ring" aria-hidden="true"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 L16 12 L9 19" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </nav>
    </div>
  </section>

  <script>
    // Show 16 rooms at a time, with arrows to move between pages. Without JavaScript every room is shown.
    // Each visit, every room card shows a random one of its pictures. The first picture is the fallback without JavaScript.
    document.querySelectorAll<HTMLElement>('.gallery-cell[data-pics]').forEach((cell) => {
      let list: string[] = [];
      try { list = JSON.parse(cell.dataset.pics || '[]'); } catch { list = []; }
      const img = cell.querySelector<HTMLImageElement>('.door-pic img');
      if (!img || list.length < 2) return;
      const src = list[Math.floor(Math.random() * list.length)];
      if (src === img.getAttribute('src')) return;
      img.style.opacity = '0';
      img.addEventListener('load', () => { img.style.opacity = '1'; }, { once: true });
      img.src = src;
    });

    const wrap = document.querySelector<HTMLElement>('.galleries-wrap');
    if (wrap) {
      const cells = [...wrap.querySelectorAll<HTMLElement>('.gallery-cell')];
      const size = 16;
      const pages = Math.ceil(cells.length / size);
      const nav = wrap.querySelector<HTMLElement>('.pager')!;
      const label = nav.querySelector<HTMLElement>('.pg-label')!;
      const prev = nav.querySelector<HTMLButtonElement>('.pg-prev')!;
      const next = nav.querySelector<HTMLButtonElement>('.pg-next')!;
      let page = 1;
      const show = () => {
        cells.forEach((c, i) => { c.hidden = Math.floor(i / size) + 1 !== page; });
        label.textContent = `Rooms ${(page - 1) * size + 1}–${Math.min(page * size, cells.length)} of ${cells.length}`;
        prev.hidden = page === 1;
        next.hidden = page === pages;
      };
      const go = (to: number) => {
        page = to;
        show();
        wrap.scrollIntoView({ block: 'start', behavior: 'smooth' });
      };
      if (pages > 1) {
        nav.hidden = false;
        prev.addEventListener('click', () => go(page - 1));
        next.addEventListener('click', () => go(page + 1));
        show();
      }
    }
  </script>
