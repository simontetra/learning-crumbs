---
// The floor plans of the galleries. Nine rooms sit on each floor, wound through in rows of three,
// and each gold crumb between two rooms leads on to the next. The Ground floor is where you come in.
// Stairs and a lift join each floor to the next. Pass `current` (a gallery slug) to show only the floor
// that room is on, with that room marked and the crumbs either side of it made larger.
import { galleries, galleryUrl } from '../lib/site';

interface Props { current?: string }
const { current } = Astro.props;

const PER_FLOOR = 9;
const COLS = 3;
const FLOOR_NAMES = ['Ground floor', 'First floor', 'Second floor', 'Third floor', 'Fourth floor'];
const floorName = (f: number) => FLOOR_NAMES[f] ?? `Floor ${f + 1}`;

const rooms = galleries.map((g, i) => {
  const floor = Math.floor(i / PER_FLOOR);
  const j = i % PER_FLOOR;
  const row = Math.floor(j / COLS);
  const k = j % COLS;
  const col = row % 2 === 0 ? k : COLS - 1 - k;
  const onFloor = Math.min(PER_FLOOR, galleries.length - floor * PER_FLOOR);
  const rows = Math.ceil(onFloor / COLS);
  return {
    ...g,
    i,
    n: i + 1,
    url: galleryUrl(g.slug),
    floor,
    x: ((col + 0.5) / COLS) * 100,
    y: ((row + 0.5) / rows) * 100,
  };
});

const floors = Array.from({ length: Math.ceil(galleries.length / PER_FLOOR) }, (_, f) => {
  const list = rooms.filter((r) => r.floor === f);
  const crumbs = list.slice(0, -1).map((r, k) => {
    const next = list[k + 1];
    return { from: r, to: next, x: (r.x + next.x) / 2, y: (r.y + next.y) / 2 };
  });
  const trail = list.map((r, k) => `${k === 0 ? 'M' : 'L'} ${r.x} ${r.y}`).join(' ');
  return { index: f, name: floorName(f), rooms: list, rows: Math.ceil(list.length / COLS), crumbs, trail };
});

const here = current ? rooms.findIndex((r) => r.slug === current) : -1;
const shown = here >= 0 ? floors.filter((f) => f.index === rooms[here].floor) : floors;
---
<div class="floors">
  {shown.map((f) => (
    <section class="floor-block" aria-labelledby={`floor-${f.index}`}>
      <h2 class="floor-name" id={`floor-${f.index}`}>{f.name}</h2>
      <div class="floor-wrap">
        <div class="floor">
          <div class="plan" style={`--rows:${f.rows}`}>
            <svg class="plan-trail" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d={f.trail} />
            </svg>
            {f.rooms.map((r) => (
              <a class:list={['map-room', r.i === here && 'here']} href={r.url} data-gallery={r.slug}
                style={`--x:${r.x}%;--y:${r.y}%`}
                aria-current={r.i === here ? 'page' : undefined}>
                <span class="map-no">{r.n}</span>
                <span class="map-title">{r.title}</span>
              </a>
            ))}
            {f.crumbs.map((c) => {
              const isNext = c.from.i === here;
              const isBack = c.from.i === here - 1;
              const href = isBack ? c.from.url : c.to.url;
              const label = isNext ? `Next: ${c.to.title} →` : isBack ? `← Back: ${c.from.title}` : c.to.title;
              const aria = isBack ? `Back to ${c.from.title}` : `Next room: ${c.to.title}`;
              return (
                <a class:list={['map-crumb', (isNext || isBack) && 'exit']} href={href}
                  style={`--x:${c.x}%;--y:${c.y}%`} aria-label={aria}>
                  <span aria-hidden="true">{label}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
      <nav class="stairs" aria-label={`Stairs and lift from the ${f.name}`}>
        {f.index > 0 && (
          <a class="stairs-down" href={rooms[PER_FLOOR * f.index - 1].url}>
            <svg class="stair-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M2 4 H6 V8 H10 V12 H14 V16 H18" /></svg>
            Down to the {floorName(f.index - 1)}
          </a>
        )}
        {f.index < floors.length - 1 && (
          <a class="stairs-up" href={rooms[PER_FLOOR * (f.index + 1)].url}>
            <svg class="stair-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M2 16 H6 V12 H10 V8 H14 V4 H18" /></svg>
            Up to the {floorName(f.index + 1)}
          </a>
        )}
      </nav>
    </section>
  ))}
</div>

<style>
  .floor-block + .floor-block { margin-top: 48px; }
  .floor-name {
    font-family: var(--font-label);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .floor-wrap { padding: 8px 0 12px; }
  .floor { padding: 28px; border-radius: 22px; background: var(--label); border: 1px solid var(--rule); box-shadow: var(--shadow-lift); }
  .plan {
    position: relative;
    width: min(90%, 720px);
    margin-inline: auto;
    aspect-ratio: 3 / var(--rows, 3);
    transform: perspective(1400px) rotateX(34deg);
    transform-origin: 50% 55%;
    transform-style: preserve-3d;
  }
  .plan-trail { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .plan-trail path { fill: none; stroke: var(--pebble); stroke-width: 2; stroke-dasharray: 1 7; stroke-linecap: round; vector-effect: non-scaling-stroke; }

  .map-room {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(100% / 3 * 0.86);
    height: calc(100% / var(--rows, 3) * 0.8);
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px;
    border-radius: 8px;
    background: var(--room-fill, var(--pebble));
    color: #fbf7ec;
    text-align: center;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 8px 0 rgb(30 25 15 / 0.35), 0 12px 20px rgb(0 0 0 / 0.2);
    transition: transform 0.2s ease;
  }
  .map-room:hover, .map-room:focus-visible { transform: translate(-50%, -50%) translateY(-4px); outline: none; }
  .map-room:focus-visible { box-shadow: 0 0 0 3px var(--accent), 0 8px 0 rgb(30 25 15 / 0.35); }
  .map-room.here {
    transform: translate(-50%, -50%) translateY(-6px);
    box-shadow: 0 0 0 3px #fbf7ec, 0 0 0 5px var(--accent), 0 10px 0 rgb(30 25 15 / 0.35), 0 16px 26px rgb(0 0 0 / 0.25);
  }
  .map-no { font-family: var(--font-label); font-size: 0.7rem; opacity: 0.8; letter-spacing: 0.05em; }
  .map-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(0.7rem, 1.3vw, 1rem); line-height: 1.15; }

  .map-crumb {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    transform: translateZ(10px);
  }
  .map-crumb::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #cf9c2e;
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    filter: drop-shadow(0 0 1px #fbf7ec) drop-shadow(0 0 1px #fbf7ec);
  }
  .map-crumb:hover::before, .map-crumb:focus-visible::before { background: #ecc25e; }
  .map-crumb:focus-visible { outline: none; }
  .map-crumb span {
    position: absolute;
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--label);
    color: var(--heading);
    font-size: var(--step--1);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .map-crumb:hover span, .map-crumb:focus-visible span { opacity: 1; }
  /* The crumbs either side of the room you are in are larger and haloed, so they read as the way on and back.
     Their labels show on hover; the Back and Next links above the plan always name the rooms. */
  .map-crumb.exit { width: 26px; height: 26px; margin: -13px 0 0 -13px; }
  .map-crumb.exit::before { background: #ecc25e; }
  .map-crumb.exit::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: rgb(236 194 94 / 0.28);
    pointer-events: none;
  }

  .stairs { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; margin-top: 14px; }
  .stairs a {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--label);
    border: 1px solid var(--rule);
    color: var(--heading);
    text-decoration: none;
    font-size: var(--step--1);
  }
  .stairs a:hover, .stairs a:focus-visible { border-color: var(--accent); }
  .stairs-up { margin-left: auto; }
  .stairs a { display: inline-flex; align-items: center; gap: 8px; }
  .stair-icon { width: 20px; height: 20px; flex: none; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: square; stroke-linejoin: miter; }

  /* Phones: the same three-wide plan, a taller tilt, and smaller labels. */
  @media (max-width: 760px) {
    .floor { padding: 16px; border-radius: 18px; }
    .plan { width: 100%; transform: perspective(900px) rotateX(26deg); }
    .map-room { padding: 4px; }
    .map-title { font-size: 0.6rem; }
    .map-no { font-size: 0.6rem; }
    .map-crumb span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-room, .map-crumb::before { transition: none; }
  }
</style>
