---
// The tilted floor plan of the galleries. Rooms wind through it in rows (six wide on a desktop,
// three wide on a phone), and each gold crumb between two rooms leads on to the next.
// Pass `current` (a gallery slug) to mark where you are, and to make the crumbs either side of it
// larger, so they read as the way on and back.
import { galleries, galleryUrl } from '../lib/site';

interface Props { current?: string }
const { current } = Astro.props;

// Positions for a plan `cols` rooms wide, as percentages of the plan.
function place(cols: number) {
  const rows = Math.ceil(galleries.length / cols);
  return galleries.map((_, i) => {
    const row = Math.floor(i / cols);
    const k = i % cols;
    const col = row % 2 === 0 ? k : cols - 1 - k;
    return { x: ((col + 0.5) / cols) * 100, y: ((row + 0.5) / rows) * 100 };
  });
}
const WIDE = 6;
const NARROW = 3;
const wide = place(WIDE);
const narrow = place(NARROW);
const rooms = galleries.map((g, i) => ({
  ...g,
  n: i + 1,
  url: galleryUrl(g.slug),
  wx: wide[i].x, wy: wide[i].y,
  nx: narrow[i].x, ny: narrow[i].y,
}));
const crumbs = rooms.slice(0, -1).map((r, i) => {
  const next = rooms[i + 1];
  return {
    from: r, to: next, index: i,
    wx: (r.wx + next.wx) / 2, wy: (r.wy + next.wy) / 2,
    nx: (r.nx + next.nx) / 2, ny: (r.ny + next.ny) / 2,
  };
});
const here = current ? rooms.findIndex((r) => r.slug === current) : -1;
const trailWide = rooms.map((r, i) => `${i === 0 ? 'M' : 'L'} ${r.wx} ${r.wy}`).join(' ');
const trailNarrow = rooms.map((r, i) => `${i === 0 ? 'M' : 'L'} ${r.nx} ${r.ny}`).join(' ');
---
<div class="floor-wrap">
  <div class="floor">
    <div class="plan">
      <svg class="plan-trail wide" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d={trailWide} />
      </svg>
      <svg class="plan-trail narrow" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d={trailNarrow} />
      </svg>
      {rooms.map((r, i) => (
        <a class:list={['map-room', i === here && 'here']} href={r.url} data-gallery={r.slug}
          style={`--wx:${r.wx}%;--wy:${r.wy}%;--nx:${r.nx}%;--ny:${r.ny}%`}
          aria-current={i === here ? 'page' : undefined}>
          <span class="map-no">{r.n}</span>
          <span class="map-title">{r.title}</span>
        </a>
      ))}
      {crumbs.map((c) => {
        const isNext = c.index === here;
        const isBack = c.index === here - 1;
        const href = isBack ? c.from.url : c.to.url;
        const label = isNext ? `Next: ${c.to.title} →` : isBack ? `← Back: ${c.from.title}` : c.to.title;
        const aria = isNext ? `Next room: ${c.to.title}` : isBack ? `Back to ${c.from.title}` : `Next room: ${c.to.title}`;
        return (
          <a class:list={['map-crumb', (isNext || isBack) && 'exit']} href={href}
            style={`--wx:${c.wx}%;--wy:${c.wy}%;--nx:${c.nx}%;--ny:${c.ny}%`}
            aria-label={aria}>
            <span aria-hidden="true">{label}</span>
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  .floor-wrap { padding: 8px 0 40px; }
  .floor { padding: 28px; border-radius: 22px; background: var(--label); border: 1px solid var(--rule); box-shadow: var(--shadow-lift); }
  .plan {
    position: relative;
    width: 90%;
    margin-inline: auto;
    aspect-ratio: 6 / 3;
    transform: perspective(1400px) rotateX(34deg);
    transform-origin: 50% 55%;
    transform-style: preserve-3d;
  }
  .plan-trail { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .plan-trail path { fill: none; stroke: var(--pebble); stroke-width: 2; stroke-dasharray: 1 7; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .plan-trail.narrow { display: none; }

  .map-room {
    position: absolute;
    left: var(--wx);
    top: var(--wy);
    width: calc(100% / 6 * 0.84);
    height: calc(100% / 3 * 0.8);
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px;
    border-radius: 8px;
    background: var(--room-fill, var(--pebble));
    color: #fbf7ec;
    text-align: center;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 8px 0 rgb(30 25 15 / 0.35), 0 12px 20px rgb(0 0 0 / 0.2);
    transition: transform 0.2s ease;
  }
  .map-room:hover, .map-room:focus-visible { transform: translate(-50%, -50%) translateY(-4px); outline: none; }
  .map-room:focus-visible { box-shadow: 0 0 0 3px var(--accent), 0 8px 0 rgb(30 25 15 / 0.35); }
  .map-room.here {
    transform: translate(-50%, -50%) translateY(-6px);
    box-shadow: 0 0 0 3px #fbf7ec, 0 0 0 5px var(--accent), 0 10px 0 rgb(30 25 15 / 0.35), 0 16px 26px rgb(0 0 0 / 0.25);
  }
  .map-no { font-family: var(--font-label); font-size: 0.7rem; opacity: 0.8; letter-spacing: 0.05em; }
  .map-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(0.62rem, 1.05vw, 0.9rem); line-height: 1.15; }

  .map-crumb {
    position: absolute;
    left: var(--wx);
    top: var(--wy);
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    transform: translateZ(10px);
  }
  .map-crumb::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #cf9c2e;
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    filter: drop-shadow(0 0 1px #fbf7ec) drop-shadow(0 0 1px #fbf7ec);
  }
  .map-crumb:hover::before, .map-crumb:focus-visible::before { background: #ecc25e; }
  .map-crumb:focus-visible { outline: none; }
  .map-crumb span {
    position: absolute;
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--label);
    color: var(--heading);
    font-size: var(--step--1);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .map-crumb:hover span, .map-crumb:focus-visible span { opacity: 1; }
  /* The crumbs either side of the room you are in are larger and haloed, so they read as the way on and back.
     Their labels show on hover; the Back and Next links above the plan always name the rooms. */
  .map-crumb.exit { width: 26px; height: 26px; margin: -13px 0 0 -13px; }
  .map-crumb.exit::before { background: #ecc25e; }
  .map-crumb.exit::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: rgb(236 194 94 / 0.28);
    pointer-events: none;
  }

  /* Phones: three rooms across, a taller plan, and a lighter tilt. */
  @media (max-width: 760px) {
    .floor { padding: 16px; border-radius: 18px; }
    .plan { width: 100%; aspect-ratio: 3 / 6; transform: perspective(900px) rotateX(26deg); }
    .plan-trail.wide { display: none; }
    .plan-trail.narrow { display: block; }
    .map-room {
      left: var(--nx);
      top: var(--ny);
      width: calc(100% / 3 * 0.86);
      height: calc(100% / 6 * 0.76);
      padding: 4px;
    }
    .map-title { font-size: 0.6rem; }
    .map-no { font-size: 0.6rem; }
    .map-crumb { left: var(--nx); top: var(--ny); }
    .map-crumb span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-room, .map-crumb::before { transition: none; }
  }
</style>
