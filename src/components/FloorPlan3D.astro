---
// The floor plan as a building you can turn and step into. It is drawn in the browser from the
// same list as everything else (src/data/galleries.json), nine rooms to a floor, so a new gallery
// or a new floor appears here with no further work. The flat <FloorPlan /> is rendered underneath
// as the fallback: it is what visitors without JavaScript see, and it is hidden once this one starts.
import { galleries, galleryUrl } from '../lib/site';
import FloorPlan from './FloorPlan.astro';

const PER_FLOOR = 9; // keep in step with FloorPlan.astro
const FLOOR_NAMES = ['Ground floor', 'First floor', 'Second floor', 'Third floor', 'Fourth floor', 'Fifth floor', 'Sixth floor', 'Seventh floor', 'Eighth floor', 'Ninth floor', 'Tenth floor'];

const floors = Array.from({ length: Math.ceil(galleries.length / PER_FLOOR) }, (_, f) => ({
  name: FLOOR_NAMES[f] ?? `Floor ${f}`,
  rooms: galleries.slice(f * PER_FLOOR, (f + 1) * PER_FLOOR).map((g) => ({ title: g.title, slug: g.slug, url: galleryUrl(g.slug) })),
}));
const data = JSON.stringify({ floors }).replace(/</g, '\\u003c');
---
<div class="fp3d" id="fp3d" hidden>
  <div class="fp-side">
    <p class="fp-status" id="fp-status" aria-live="polite"></p>
    <nav class="fp-lift" aria-label="Floors">
      <ol id="fp-keys"></ol>
      <button class="fp-whole" id="fp-whole" type="button" aria-pressed="true"><span class="fp-key" aria-hidden="true"></span><span class="fp-nm">Whole<span class="fp-fl"> building</span></span></button>
    </nav>
    <p class="fp-hint">Drag to turn the building. Pick a floor to step inside, then pick a room to go in.</p>
  </div>
  <div class="fp-stage" id="fp-stage" role="group" aria-label="The building in 3D">
    <div class="fp-world fp-all" id="fp-world"></div>
  </div>
</div>
<div id="fp3d-fallback"><FloorPlan /></div>
<script type="application/json" id="fp3d-data" set:html={data} />

<style is:global>
  .fp3d {
    --fp-crumb: #cf9c2e;
    display: grid; grid-template-columns: minmax(200px, 250px) minmax(0, 1fr);
    background: var(--label); border: 1px solid var(--rule); border-radius: 22px; box-shadow: var(--shadow-lift); overflow: hidden;
  }
  .fp3d[hidden] { display: none; }
  .fp3d *, .fp3d *::before, .fp3d *::after { box-sizing: border-box; }
  .fp-side { display: flex; flex-direction: column; gap: 16px; padding: 22px 6px 20px 22px; min-height: 0; max-height: clamp(440px, 74svh, 760px); overflow: auto; }
  .fp-status { margin: 0; color: var(--muted); font-size: var(--step--1); line-height: 1.45; min-height: 5.8em; }
  .fp-lift { background: var(--wall); border: 1px solid var(--rule); border-radius: 18px; padding: 7px; }
  .fp-lift ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .fp-lift button {
    all: unset; box-sizing: border-box; cursor: pointer; width: 100%;
    display: grid; grid-template-columns: 38px 1fr; gap: 11px; align-items: center;
    padding: 6px 9px 6px 6px; border-radius: 12px; font-family: var(--font-body); color: var(--ink);
  }
  .fp-lift button:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .fp-lift button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .fp-key { width: 38px; height: 38px; border-radius: 50%; border: 2px solid var(--accent); display: grid; place-items: center; font-family: var(--font-label); font-weight: 700; font-size: 1rem; color: var(--heading); transition: background 0.25s, color 0.25s; }
  .fp-lift button[aria-pressed="true"] .fp-key { background: var(--accent); color: var(--label); }
  .fp-nm { display: flex; flex-direction: column; line-height: 1.2; font-weight: 700; color: var(--heading); }
  .fp-nm small { font-weight: 400; color: var(--muted); font-size: 0.82rem; }
  .fp-lift .fp-whole { margin-top: 5px; padding-top: 11px; border-top: 1px solid var(--rule); border-radius: 0 0 12px 12px; }
  .fp-lift .fp-whole .fp-key, .fp-lift .fp-whole[aria-pressed="true"] .fp-key {
    background:
      linear-gradient(var(--heading) 0 0) center 9px / 16px 3px no-repeat,
      linear-gradient(var(--heading) 0 0) center 15px / 16px 3px no-repeat,
      linear-gradient(var(--heading) 0 0) center 21px / 16px 3px no-repeat,
      linear-gradient(var(--heading) 0 0) center 27px / 16px 3px no-repeat;
    border-color: var(--heading);
  }
  .fp-lift .fp-whole[aria-pressed="true"] .fp-key { background-color: color-mix(in srgb, var(--accent) 30%, transparent); }
  .fp-hint { margin: auto 0 0; color: var(--muted); font-size: 0.82rem; line-height: 1.4; }

  .fp-stage {
    position: relative; overflow: hidden; height: clamp(440px, 74svh, 760px);
    perspective: 1500px; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none;
    background: radial-gradient(ellipse at 50% 55%, var(--label), var(--wall) 85%);
    border-left: 1px solid var(--rule);
  }
  .fp-stage.fp-dragging { cursor: grabbing; }
  .fp-world {
    position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d;
    --rx: 62deg; --rz: -38deg; --zoom: 1; --fz: 255px; --ox: 0px; --oy: 0px; --py: 0px; --ss: 1; --lw: 120px;
    transform: translateY(var(--py)) scale3d(var(--zoom), var(--zoom), var(--zoom)) rotateX(var(--rx)) rotateZ(var(--rz)) translate3d(calc(-1 * var(--ox)), calc(-1 * var(--oy)), calc(-1 * var(--fz)));
  }
  .fp-ground { position: absolute; transform: translateZ(-18px); background: radial-gradient(closest-side, color-mix(in srgb, var(--ink) 22%, transparent), transparent); pointer-events: none; }
  .fp-frame, .fp-floor { position: absolute; transform-style: preserve-3d; }
  .fp-floor { --o: 1; --d: 0ms; transform: translateZ(var(--zf)); transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d), visibility 0s 0s; }
  .fp-world:not(.fp-ready) .fp-floor { --d: calc(var(--f) * 140ms); }
  .fp-floor.fp-pre { --o: 0; transform: translateZ(calc(var(--zf) - 220px)); }
  .fp-floor.fp-below { --o: 0.18; }
  .fp-floor.fp-above { --o: 0; transform: translateZ(calc(var(--zf) + 150px)); visibility: hidden; pointer-events: none; transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s 0.5s; }
  .fp-lf { opacity: var(--o); transition: opacity 0.5s var(--d); }
  .fp-floor * { position: absolute; }
  .fp-floor i { display: block; }

  .fp-slab { inset: 0; background: var(--plate); border: 1.5px solid color-mix(in srgb, var(--plate) 70%, var(--ink)); border-radius: 3px; }
  .fp-world.fp-all .fp-floor:hover .fp-slab { background: color-mix(in srgb, var(--accent) 22%, var(--plate)); }
  .fp-skirt { background: color-mix(in srgb, var(--plate) 62%, var(--ink)); }
  .fp-skirt.fp-e, .fp-skirt.fp-w { background: color-mix(in srgb, var(--plate) 50%, var(--ink)); }

  /* Each room is painted its gallery's own colour, taken from --room-fill via data-gallery. */
  a.fp-room { width: 120px; height: 120px; transform-style: preserve-3d; transform: translateZ(1px); color: inherit; text-decoration: none; -webkit-user-drag: none; outline: none; }
  .fp-tile { inset: 0; background: color-mix(in srgb, var(--room-fill) 14%, var(--label)); border: 1px solid color-mix(in srgb, var(--room-fill) 45%, var(--rule)); transition: background 0.2s, opacity 0.5s var(--d); }
  .fp-focus a.fp-room:hover .fp-tile, .fp-focus a.fp-room:focus-visible .fp-tile { background: color-mix(in srgb, var(--room-fill) 40%, var(--label)); }
  .fp-wall { transform-origin: 0 0; }
  .fp-w-n { background: color-mix(in srgb, var(--room-fill) 90%, white); }
  .fp-w-s { background: color-mix(in srgb, var(--room-fill) 80%, black); }
  .fp-w-e { background: color-mix(in srgb, var(--room-fill) 90%, black); }
  .fp-w-w { background: var(--room-fill); }

  svg.fp-crumbs { transform: translateZ(3px); pointer-events: none; }
  .fp-crumb { fill: var(--fp-crumb); }
  .fp-reveal { fill: none; stroke: #fff; stroke-width: 26; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: var(--len); stroke-dashoffset: 0; animation: fp-lay 0.75s linear both; animation-delay: calc(1000ms + var(--f) * 620ms); }
  @keyframes fp-lay { from { stroke-dashoffset: var(--len); } to { stroke-dashoffset: 0; } }
  .fp-walker { fill: var(--heading); stroke: var(--label); stroke-width: 2.5; display: none; }
  .fp-focus .fp-walker { display: block; }

  .fp-tread { background: var(--pebble); border: 1px solid color-mix(in srgb, var(--pebble) 60%, var(--ink)); }
  .fp-stairs { transform-style: preserve-3d; left: 0; top: 0; width: 0; height: 0; }
  .fp-focus .fp-stairs { cursor: pointer; }

  /* Signs are counter-rotated so they always face the visitor. */
  .fp-sign { width: max-content; transform-origin: 0 0; transform: translateZ(var(--lift, 30px)) rotateZ(calc(-1 * var(--rz))) rotateX(calc(-1 * var(--rx))) scale(var(--ss)) translate(-50%, -100%); }
  a.fp-room .fp-sign { left: 50%; top: 50%; }
  .fp-sign-in { position: relative !important; display: flex; flex-direction: column; align-items: center; padding-bottom: 9px; transition: transform 0.2s; }
  .fp-sign-in::after { content: ""; position: absolute; bottom: 0; left: 50%; width: 2px; height: 9px; margin-left: -1px; background: var(--room-fill); }
  .fp-sign-in > * { position: static; }
  .fp-num { min-width: 22px; height: 22px; border-radius: 11px; padding: 0 6px; background: var(--room-fill); color: var(--room-ink); font-family: var(--font-label); font-weight: 700; font-size: 12px; line-height: 22px; text-align: center; }
  .fp-ttl { display: none; margin-top: 3px; max-width: var(--lw); text-align: center; background: var(--label); color: var(--heading); border: 1px solid var(--rule); border-radius: 6px; padding: 4px 7px 5px; font-family: var(--font-display); font-size: 13.5px; line-height: 1.14; font-weight: 700; text-wrap: balance; } /* no shadow here: it upsets the browser's 3D layer sorting */
  .fp-focus .fp-ttl { display: block; animation: fp-pop 0.35s cubic-bezier(0.3, 1.5, 0.5, 1) both; animation-delay: calc(260ms + var(--k) * 45ms); }
  @keyframes fp-pop { from { opacity: 0; transform: translateY(8px) scale(0.9); } to { opacity: 1; transform: none; } }
  .fp-focus a.fp-room:hover .fp-sign-in, .fp-focus a.fp-room:focus-visible .fp-sign-in { transform: translateY(-7px); }
  .fp-focus a.fp-room:hover .fp-ttl, .fp-focus a.fp-room:focus-visible .fp-ttl { background: var(--room-fill); color: var(--room-ink); border-color: var(--room-fill); }
  .fp-focus a.fp-room:focus-visible .fp-ttl { outline: 2.5px solid var(--accent); outline-offset: 2px; }

  .fp-tag { font-family: var(--font-label); font-size: 12px; line-height: 1; padding: 6px 10px; border-radius: 999px; white-space: nowrap; background: var(--heading); color: var(--label); }
  .fp-ftag, .fp-way { --room-fill: var(--heading); }
  .fp-ftag { display: none; }
  .fp-world.fp-all .fp-ftag { display: block; }
  .fp-way .fp-tag { background: var(--label); color: var(--heading); border: 1.5px solid var(--fp-crumb); }
  .fp-way .fp-sign-in::after { background: var(--fp-crumb); }
  .fp-floor.fp-below .fp-way, .fp-floor.fp-below .fp-ftag, .fp-world.fp-narrow .fp-ftag { display: none; }
  .fp-narrow .fp-ttl { font-size: 12px; padding: 3px 5px 4px; }
  .fp-world.fp-all.fp-tiny a.fp-room .fp-sign, .fp-world.fp-tiny .fp-ttl { display: none; }

  .fp-shaft { background: color-mix(in srgb, var(--ink) 5%, transparent); border: 1.5px solid color-mix(in srgb, var(--ink) 30%, transparent); position: absolute; display: block; transform-origin: 0 0; pointer-events: none; }
  .fp-car { position: absolute; width: 40px; height: 40px; transform-style: preserve-3d; pointer-events: none; }
  .fp-car i { position: absolute; display: block; transform-origin: 0 0; background: color-mix(in srgb, var(--heading) 80%, var(--label)); }
  .fp-car .fp-top { inset: 0; transform: translateZ(44px); background: var(--heading); }

  @media (max-width: 760px) {
    .fp3d { grid-template-columns: minmax(0, 1fr); border-radius: 18px; }
    .fp-side { display: contents; }
    .fp-status { order: 1; padding: 14px 16px 10px; min-height: 0; }
    .fp-stage { order: 2; border-left: 0; border-block: 1px solid var(--rule); height: clamp(400px, 68svh, 620px); }
    .fp-lift { order: 3; margin: 8px; padding: 5px; display: flex; min-width: 0; }
    .fp-hint { display: none; }
    .fp-lift ol { flex-direction: row; flex: 4; min-width: 0; overflow-x: auto; scrollbar-width: none; }
    .fp-lift li { flex: 1 0 58px; order: var(--ord); }
    .fp-lift button { display: flex; flex-direction: column; gap: 3px; padding: 5px 2px; text-align: center; }
    .fp-lift .fp-whole { flex: 0 0 64px; margin: 0; padding: 5px 2px; border-top: 0; border-left: 1px solid var(--rule); border-radius: 0 12px 12px 0; }
    .fp-nm { font-size: 0.74rem; }
    .fp-nm small, .fp-nm .fp-fl { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fp-floor, .fp-lf, .fp-tile, .fp-sign-in { transition: none !important; }
    .fp-reveal, .fp-focus .fp-ttl { animation: none; }
    .fp-walker { display: none !important; }
  }
</style>

<script>
// @ts-nocheck
(function () {
  const root = document.getElementById('fp3d');
  const dataEl = document.getElementById('fp3d-data');
  if (!root || !dataEl || !CSS.supports('transform-style', 'preserve-3d')) return;
  const DATA = JSON.parse(dataEl.textContent);
  const N = DATA.floors.length;
  if (!N) return;

  const G = 170, R = 120, GAP = 14, HALL = 64, PADT = 18, PADR = 18, FRONT = 50, WALL = 22, DOOR = 40, SKIRT = 10, PITCH = R + GAP;
  let count = 0;
  const FLOORS = DATA.floors.map((src, f) => {
    const rooms = src.rooms || [], n = rooms.length;
    const cols = n <= 4 ? 2 : 3; // three across keeps every sign readable on a phone; busy floors grow deeper
    const rows = Math.max(1, Math.ceil(n / cols));
    const short = src.name.replace(/\s+floor$/i, '');
    const F = { name: src.name, short, key: f === 0 ? 'G' : String(f), hash: short.toLowerCase().replace(/[^a-z0-9]+/g, '-') || 'floor-' + f,
      rooms, n, cols, rows, start: count,
      W: HALL + cols * R + (cols - 1) * GAP + PADR, D: PADT + rows * R + (rows - 1) * GAP + FRONT };
    count += n; return F;
  });
  const TOTAL = count, WMAX = Math.max(...FLOORS.map((F) => F.W)), DMAX = Math.max(...FLOORS.map((F) => F.D));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage = document.getElementById('fp-stage'), world = document.getElementById('fp-world');
  const statusEl = document.getElementById('fp-status'), keys = document.getElementById('fp-keys'), whole = document.getElementById('fp-whole');
  const SVGNS = 'http://www.w3.org/2000/svg';

  function el(tag, cls, css) { const e = document.createElement(tag); if (cls) e.className = cls; if (css) Object.assign(e.style, css); return e; }
  function span(cls, text) { const s = el('span', cls); if (text !== undefined) s.textContent = text; return s; }
  const px = (n) => n + 'px';
  const midX = (c) => HALL + c * PITCH + R / 2, midY = (r) => PADT + r * PITCH + R / 2;
  let seed = 7; function rnd() { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; }

  function wall(side, a, len, base, h, cls) {
    const d = el('i', cls + ' fp-w-' + side), s = d.style;
    if (side === 'n' || side === 's') { s.left = px(a); s.top = px(side === 'n' ? 0 : base); s.width = px(len); s.height = px(h); s.transform = 'rotateX(90deg)'; }
    else { s.left = px(side === 'w' ? 0 : base); s.top = px(a); s.width = px(h); s.height = px(len); s.transform = 'rotateY(-90deg)'; }
    return d;
  }
  function sideTo(a, b) { const dx = b[0] - a[0], dy = b[1] - a[1]; return dx === 1 ? 'e' : dx === -1 ? 'w' : dy === 1 ? 's' : 'n'; }
  function billboard(cls, x, y, lift, inner) {
    const s = el('span', 'fp-sign fp-lf ' + cls, { left: px(x), top: px(y) }); s.style.setProperty('--lift', px(lift));
    const i = el('span', 'fp-sign-in'); i.append(inner); s.append(i); return s;
  }
  const roomsLabel = (F) => F.n === 0 ? 'No rooms yet' : F.n === 1 ? 'Room ' + (F.start + 1) : 'Rooms ' + (F.start + 1) + ' to ' + (F.start + F.n);

  let mode = 'all', cur = 0, interacted = false, hovering = false, drag = null, suppress = false;
  const floorEls = [];
  FLOORS.forEach((F, f) => {
    const { W, D } = F, top = f === N - 1, cy = midY(0);
    const fl = el('section', 'fp-floor fp-pre', { left: px(-WMAX / 2), top: px(-DMAX / 2), width: px(W), height: px(D) });
    fl.style.setProperty('--zf', px(f * G)); fl.style.setProperty('--f', Math.min(f, 6));
    fl.setAttribute('aria-label', F.name);
    fl.append(el('i', 'fp-slab fp-lf'));
    [['n', 0, 0, W, SKIRT, 'rotateX(-90deg)'], ['s', 0, D, W, SKIRT, 'rotateX(-90deg)'], ['w', 0, 0, SKIRT, D, 'rotateY(90deg)'], ['e', W, 0, SKIRT, D, 'rotateY(90deg)']]
      .forEach(([n, l, t, w, h, tr]) => fl.append(el('i', 'fp-skirt fp-lf fp-' + n, { left: px(l), top: px(t), width: px(w), height: px(h), transformOrigin: '0 0', transform: tr })));

    // rooms wind left to right, then right to left, from the back row to the front (as in FloorPlan.astro)
    const cells = F.rooms.map((_, k) => { const r = Math.floor(k / F.cols), i = k % F.cols; return [r % 2 ? F.cols - 1 - i : i, r]; });
    cells.forEach((cell, k) => {
      const room = F.rooms[k], num = F.start + k + 1;
      const a = el('a', 'fp-room', { left: px(HALL + cell[0] * PITCH), top: px(PADT + cell[1] * PITCH) });
      a.href = room.url; a.tabIndex = -1; a.draggable = false; a.dataset.gallery = room.slug;
      a.setAttribute('aria-label', 'Room ' + num + ': ' + room.title);
      a.style.setProperty('--k', Math.min(k, 14));
      a.append(el('i', 'fp-tile fp-lf'));
      const doors = new Set();
      doors.add(k > 0 ? sideTo(cell, cells[k - 1]) : 'w');              // in from the hall, or from the room before
      if (k < F.n - 1) doors.add(sideTo(cell, cells[k + 1])); else if (!top) doors.add('s'); // out to the front hall
      ['n', 's', 'w', 'e'].forEach((s) => {
        if (doors.has(s)) { const seg = (R - DOOR) / 2; a.append(wall(s, 0, seg, R, WALL, 'fp-wall fp-lf'), wall(s, R - seg, seg, R, WALL, 'fp-wall fp-lf')); }
        else a.append(wall(s, 0, R, R, WALL, 'fp-wall fp-lf'));
      });
      const frag = document.createDocumentFragment(), nu = span('fp-num', num), tt = span('fp-ttl', room.title);
      nu.setAttribute('aria-hidden', 'true'); tt.setAttribute('aria-hidden', 'true'); frag.append(nu, tt);
      const sg = billboard('', 0, 0, 30, frag); sg.style.left = '50%'; sg.style.top = '50%';
      a.append(sg); fl.append(a);
    });

    // crumb trail: in from the door or the stairs, through the rooms, back along the halls to the stairs
    const pts = f === 0 ? [[40, D + 30], [40, cy + 12]] : [[-8, cy + 17], [48, cy + 17]];
    cells.forEach((c) => pts.push([midX(c[0]), midY(c[1])]));
    if (!top) {
      if (F.n) pts.push([midX(cells[F.n - 1][0]), D - 25], [22, D - 25]);
      pts.push([22, cy - 17], [-8, cy - 17]);
    }
    const M = 70, svg = document.createElementNS(SVGNS, 'svg');
    svg.setAttribute('class', 'fp-crumbs fp-lf'); svg.setAttribute('viewBox', [-M, -M, W + 2 * M, D + 2 * M].join(' ')); svg.setAttribute('aria-hidden', 'true');
    Object.assign(svg.style, { left: px(-M), top: px(-M), width: px(W + 2 * M), height: px(D + 2 * M) });
    const dPath = 'M' + pts.map((p) => p.join(' ')).join(' L'); let total = 0;
    const mask = document.createElementNS(SVGNS, 'mask'); mask.id = 'fp-mk' + f; mask.setAttribute('maskUnits', 'userSpaceOnUse');
    mask.setAttribute('x', -M); mask.setAttribute('y', -M); mask.setAttribute('width', W + 2 * M); mask.setAttribute('height', D + 2 * M);
    const rv = document.createElementNS(SVGNS, 'path'); rv.setAttribute('class', 'fp-reveal'); rv.setAttribute('d', dPath); mask.append(rv); svg.append(mask);
    const trail = document.createElementNS(SVGNS, 'g'); trail.setAttribute('mask', 'url(#fp-mk' + f + ')'); svg.append(trail);
    for (let i = 0; i < pts.length - 1; i++) {
      const [x1, y1] = pts[i], [x2, y2] = pts[i + 1], len = Math.hypot(x2 - x1, y2 - y1); if (len < 1) continue;
      const steps = Math.max(2, Math.round(len / 15)); total += len;
      for (let s = (i ? 1 : 0); s <= steps; s++) {
        const t = s / steps, nx = -(y2 - y1) / len, ny = (x2 - x1) / len, j = (rnd() - 0.5) * 9;
        const g = document.createElementNS(SVGNS, 'g');
        g.setAttribute('transform', 'translate(' + (x1 + (x2 - x1) * t + nx * j).toFixed(1) + ' ' + (y1 + (y2 - y1) * t + ny * j).toFixed(1) + ') rotate(' + Math.round(rnd() * 180) + ')');
        const c = document.createElementNS(SVGNS, 'ellipse'); c.setAttribute('class', 'fp-crumb');
        c.setAttribute('rx', (2.2 + rnd() * 2.2).toFixed(1)); c.setAttribute('ry', (1.6 + rnd() * 1.5).toFixed(1));
        g.append(c); trail.append(g);
      }
    }
    rv.style.setProperty('--len', Math.ceil(total) + 2);
    const wk = document.createElementNS(SVGNS, 'circle'); wk.setAttribute('class', 'fp-walker'); wk.setAttribute('r', '5.5');
    const am = document.createElementNS(SVGNS, 'animateMotion'); am.setAttribute('dur', Math.round(8 + total / 90) + 's'); am.setAttribute('repeatCount', 'indefinite');
    am.setAttribute('path', dPath); wk.append(am); svg.append(wk);
    fl.append(svg);

    // dog-leg stairs, stacked in the same stairwell on every floor
    if (!top) {
      const st = el('div', 'fp-stairs'), rise = G / 14, dep = 14, run = 6 * dep, lane = 30;
      const put = (x, y, w, h, z) => st.append(el('i', 'fp-tread fp-lf', { left: px(-6 - x - w), top: px(y), width: px(w), height: px(h), transform: 'translateZ(' + z.toFixed(1) + 'px)' }));
      for (let i = 0; i < 6; i++) put(i * dep, cy - lane - 2, dep, lane, (i + 1) * rise);
      put(run, cy - lane - 2, lane, lane * 2 + 4, 7 * rise);
      for (let j = 0; j < 6; j++) put(run - (j + 1) * dep, cy + 2, dep, lane, (8 + j) * rise);
      st.addEventListener('click', (e) => { if (mode === 'floor' && cur === f) { e.stopPropagation(); select(f + 1); } });
      fl.append(st);
    }
    if (f === 0) fl.append(billboard('fp-way', 40, D + 34, 6, span('fp-tag', 'Way in')));
    fl.append(billboard('fp-ftag', W + 16, D + 16, 0, span('fp-tag', F.name)));

    fl.addEventListener('click', (e) => { if (mode !== 'floor' || cur !== f) { e.preventDefault(); select(f); } });
    world.append(fl); floorEls.push(fl);

    const li = el('li'), b = el('button'); b.type = 'button'; b.setAttribute('aria-pressed', 'false');
    const key = span('fp-key', F.key); key.setAttribute('aria-hidden', 'true');
    const nm = span('fp-nm'), line = span('', F.short); line.append(span('fp-fl', /floor$/i.test(F.name) ? ' floor' : ''));
    const sm = el('small'); sm.textContent = roomsLabel(F);
    nm.append(line, sm);
    b.append(key, nm); b.addEventListener('click', () => select(f)); li.append(b); li.style.setProperty('--ord', f); keys.prepend(li); F.btn = b;
  });

  // ground shadow + lift, both sized to the building
  const GS = Math.max(WMAX, DMAX) * 1.55;
  world.prepend(el('div', 'fp-ground', { left: px(-GS / 2), top: px(-GS / 2), width: px(GS), height: px(GS) }));
  const frame = el('div', 'fp-frame', { left: px(-WMAX / 2), top: px(-DMAX / 2), width: px(WMAX), height: px(DMAX) }), HT = (N - 1) * G + 70;
  const LX = 8, LY = -62, LS = 48;
  const sn = wall('n', LX, LS, 0, HT, 'fp-shaft'), ss = wall('s', LX, LS, 0, HT, 'fp-shaft'), sw = wall('w', LY, LS, 0, HT, 'fp-shaft'), se = wall('e', LY, LS, LX + LS, HT, 'fp-shaft');
  sn.style.top = px(LY); ss.style.top = px(LY + LS); sw.style.left = px(LX);
  const car = el('div', 'fp-car', { left: px(LX + 4), top: px(LY + 4) });
  car.append(wall('n', 0, 40, 0, 44, ''), wall('s', 0, 40, 40, 44, ''), wall('w', 0, 40, 0, 44, ''), wall('e', 0, 40, 40, 44, ''), el('i', 'fp-top'));
  frame.append(sn, ss, sw, se, car); world.append(frame);

  // ---------- camera ----------
  const cam = { rx: 62, rz: -38, zoom: 0.6, fz: (N - 1) * G / 2, ox: 0, oy: 0, py: 0, car: 2 }, tgt = Object.assign({}, cam);
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const near = (t, c) => t + Math.round((c - t) / 360) * 360;
  function fit() {
    const w = stage.clientWidth, h = stage.clientHeight, narrow = w < 620;
    world.classList.toggle('fp-narrow', narrow);
    if (mode === 'all') {
      tgt.zoom = clamp(Math.min(w / ((WMAX + DMAX) * 0.75 + (narrow ? 40 : 190)), h / ((N - 1) * G * 0.88 + (WMAX + DMAX) * 0.33 + 120)), 0.1, 1.5);
      tgt.fz = (N - 1) * G / 2; tgt.ox = 0; tgt.oy = 0; tgt.py = 0;
    } else {
      const F = FLOORS[cur];
      tgt.zoom = narrow ? clamp(Math.min(w / (F.W + 80), h / (F.D * 0.914 + 190)), 0.2, 1.7)
                        : clamp(Math.min(w / (F.W * 0.848 + F.D * 0.53 + 200), h / ((F.W * 0.53 + F.D * 0.848) * 0.64 + 200)), 0.2, 1.7);
      tgt.fz = cur * G; tgt.ox = (F.W - WMAX) / 2; tgt.oy = (F.D - DMAX) / 2; tgt.py = narrow ? 34 : 26;
    }
    world.classList.toggle('fp-tiny', PITCH * tgt.zoom < (mode === 'all' ? 30 : 62));
    world.style.setProperty('--lw', px(Math.round(narrow ? clamp(PITCH * tgt.zoom - 8, 70, 128) : clamp(107 * tgt.zoom, 80, 128))));
    return narrow;
  }
  function apply() {
    const s = world.style;
    s.setProperty('--rx', cam.rx.toFixed(2) + 'deg'); s.setProperty('--rz', cam.rz.toFixed(2) + 'deg');
    s.setProperty('--zoom', cam.zoom.toFixed(4)); s.setProperty('--fz', cam.fz.toFixed(1) + 'px');
    s.setProperty('--ox', cam.ox.toFixed(1) + 'px'); s.setProperty('--oy', cam.oy.toFixed(1) + 'px');
    s.setProperty('--py', cam.py.toFixed(1) + 'px'); s.setProperty('--ss', (1 / cam.zoom).toFixed(4));
    car.style.transform = 'translateZ(' + cam.car.toFixed(1) + 'px)';
  }
  let last = performance.now(), started = false, visible = true;
  function tick(now) {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    if (mode === 'all' && !interacted && !hovering && !reduced && started && visible) tgt.rz += dt * 5;
    const k = reduced ? 1 : 1 - Math.exp(-dt * 6.5); let moved = false;
    for (const p in tgt) { const d = tgt[p] - cam[p]; if (Math.abs(d) > 0.0008) { cam[p] += Math.abs(d) < 0.002 ? d : d * k; moved = true; } }
    if (moved) apply();
    requestAnimationFrame(tick);
  }

  function select(f, quiet) {
    if (f === null || f === undefined) { mode = 'all'; } else { mode = 'floor'; cur = clamp(f, 0, N - 1); interacted = true; }
    world.classList.toggle('fp-all', mode === 'all');
    floorEls.forEach((fl, i) => {
      const on = mode === 'floor' && i === cur;
      fl.classList.toggle('fp-focus', on);
      fl.classList.toggle('fp-below', mode === 'floor' && i < cur);
      fl.classList.toggle('fp-above', mode === 'floor' && i > cur);
      fl.querySelectorAll('a.fp-room').forEach((a) => (a.tabIndex = on ? 0 : -1));
      FLOORS[i].btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    whole.setAttribute('aria-pressed', mode === 'all' ? 'true' : 'false');
    const narrow = fit();
    if (mode === 'all') {
      tgt.rx = 62; tgt.rz = near(-38, tgt.rz);
      statusEl.textContent = N + (N === 1 ? ' floor, ' : ' floors, ') + TOTAL + ' rooms. You come in on the ground floor and follow the crumbs up.';
    } else {
      const F = FLOORS[cur]; tgt.rx = narrow ? 24 : 50; tgt.rz = near(narrow ? 0 : -32, tgt.rz); tgt.car = cur * G + 2;
      let t = F.name + ': ' + roomsLabel(F).toLowerCase() + '.';
      if (F.n > 1) t += ' The crumbs lead from ' + F.rooms[0].title + ' to ' + F.rooms[F.n - 1].title + (cur < N - 1 ? ', then up the stairs.' : '.');
      statusEl.textContent = t;
      const ol = keys; if (ol.scrollWidth > ol.clientWidth) ol.scrollLeft = F.btn.parentNode.offsetLeft - ol.clientWidth / 2 + 29;
    }
    if (!quiet) { try { const h = mode === 'all' ? '' : '#' + FLOORS[cur].hash;
      if (location.hash !== h) history.replaceState(null, '', h || location.pathname + location.search); } catch (e) {} }
  }
  function fromHash() { const i = FLOORS.findIndex((F) => '#' + F.hash === location.hash); select(i < 0 ? null : i, true); }
  whole.addEventListener('click', () => { interacted = true; select(null); });
  addEventListener('hashchange', fromHash);

  // drag to turn. On touch, up-and-down swipes still scroll the page (touch-action: pan-y).
  stage.addEventListener('pointerdown', (e) => { if (e.button) return; drag = { x: e.clientX, y: e.clientY, rz: tgt.rz, rx: tgt.rx, moved: false, touch: e.pointerType === 'touch' }; });
  addEventListener('pointermove', (e) => {
    if (!drag) return; const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    if (!drag.moved && Math.hypot(dx, dy) < 6) return;
    drag.moved = true; interacted = true; stage.classList.add('fp-dragging');
    tgt.rz = drag.rz - dx * 0.35; if (!drag.touch) tgt.rx = clamp(drag.rx - dy * 0.3, 22, 80);
  });
  function endDrag() { if (!drag) return; suppress = drag.moved; drag = null; stage.classList.remove('fp-dragging'); setTimeout(() => (suppress = false), 0); }
  addEventListener('pointerup', endDrag); addEventListener('pointercancel', endDrag);
  stage.addEventListener('click', (e) => { if (suppress) { e.preventDefault(); e.stopPropagation(); } }, true);
  stage.addEventListener('dragstart', (e) => e.preventDefault());
  stage.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovering = true; });
  stage.addEventListener('pointerleave', () => (hovering = false));
  root.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { interacted = true; tgt.rz += e.key === 'ArrowLeft' ? 15 : -15; e.preventDefault(); }
    else if (e.key === 'Escape' && mode === 'floor') { interacted = true; select(null); }
  });
  new ResizeObserver(() => fit()).observe(stage);
  if ('IntersectionObserver' in window) new IntersectionObserver((en) => (visible = en[0].isIntersecting)).observe(stage);

  // swap the flat plan for this one, then open: floors stack up and the trail is laid
  const fallback = document.getElementById('fp3d-fallback');
  root.hidden = false; if (fallback) fallback.hidden = true;
  fromHash(); Object.assign(cam, tgt); cam.rz = tgt.rz - (reduced ? 0 : 24); apply();
  requestAnimationFrame(() => requestAnimationFrame(() => {
    floorEls.forEach((fl) => fl.classList.remove('fp-pre'));
    setTimeout(() => { world.classList.add('fp-ready'); started = true; }, 1500);
  }));
  requestAnimationFrame(tick);
})();
</script>
